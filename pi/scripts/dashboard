#!/usr/bin/env python3
from __future__ import annotations

import json
import sys

from dashboard_runtime import DashboardError, RESPONSE_SCHEMA, run_request


def main() -> int:
    try:
        request = json.load(sys.stdin)
        payload = run_request(request)
        exit_code = 0
    except (DashboardError, json.JSONDecodeError) as exc:
        payload = {
            "schema_version": RESPONSE_SCHEMA,
            "request_id": None,
            "ok": False,
            "status": "invalid_input",
            "epic_id": None,
            "result": {},
            "errors": [{"code": "E_DASHBOARD_INVALID", "message": str(exc)}],
        }
        exit_code = 2
    except Exception as exc:
        payload = {
            "schema_version": RESPONSE_SCHEMA,
            "request_id": None,
            "ok": False,
            "status": "runtime_error",
            "epic_id": None,
            "result": {},
            "errors": [{"code": "E_DASHBOARD_RUNTIME", "message": str(exc)}],
        }
        exit_code = 4
    print(json.dumps(payload, separators=(",", ":"), ensure_ascii=False))
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
