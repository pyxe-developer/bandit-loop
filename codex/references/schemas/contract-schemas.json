        "schema_version": {
          "const": "codex-bandit.route-card.v1"
        },
        "work_item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
        },
        "stage_plan": {
          "type": "object",
          "required": [
