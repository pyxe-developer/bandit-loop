{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "codex-bandit.contract-schemas.v1",
  "source_contracts": [
    "02a-route-card",
    "02b-evidence-reducer",
    "02c-script-stage-dispatch",
    "02d-verdict-rubric-delivery",
    "02e-enforced-compatibility",
    "adversarial-amendment"
  ],
  "exit_codes": {
    "0": {
      "meaning": "operation succeeded and predicates passed",
      "allowed_status": [
        "pass"
      ],
      "ok": true
    },
    "1": {
      "meaning": "predicate failure or workflow blocker",
      "allowed_status": [
        "blocked",
        "fail",
        "changes_requested",
        "cannot_judge",
        "deferred"
      ],
      "ok": false
    },
    "2": {
      "meaning": "invalid input or schema violation",
      "allowed_status": [
        "invalid_input"
      ],
      "ok": false
    },
    "3": {
      "meaning": "subject drift, dirty state, or missing prerequisite evidence",
      "allowed_status": [
        "stale",
        "blocked"
      ],
      "ok": false
    },
    "4": {
      "meaning": "runtime/tool failure",
      "allowed_status": [
        "runtime_error"
      ],
      "ok": false
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "role",
        "mode"
      ],
      "properties": {
        "role": {
          "enum": [
            "orchestrator",
            "issue_planner",
            "test_writer",
            "code_writer",
            "adversarial_reviewer",
            "prepare_pr",
            "land_deploy",
            "closeout_retro",
            "human"
          ]
        },
        "mode": {
          "enum": [
            "assisted",
            "manual",
            "enforced"
          ]
        },
        "id": {},
        "agent_address": {},
        "agent_set_id": {},
        "config_digest": {},
        "session_id": {}
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "stage",
        "owner_role",
        "retryable",
        "requires_human"
      ],
      "properties": {
        "code": {},
        "severity": {
          "enum": [
            "warning",
            "blocker",
            "fatal"
          ]
        },
        "message": {},
        "stage": {
          "enum": [
            "plan",
            "red",
            "green",
            "adversarial",
            "prepare_pr",
            "hitl_merge_checkpoint",
            "land_deploy",
            "closeout"
          ]
        },
        "owner_role": {
          "enum": [
            "orchestrator",
            "issue_planner",
            "test_writer",
            "code_writer",
            "adversarial_reviewer",
            "prepare_pr",
            "land_deploy",
            "closeout_retro",
            "human"
          ]
        },
        "evidence_ids": {},
        "field_path": {},
        "suggested_next_stage": {
          "enum": [
            "plan",
            "red",
            "green",
            "adversarial",
            "prepare_pr",
            "hitl_merge_checkpoint",
            "land_deploy",
            "closeout"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "requires_human": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "enum": [
        "plan",
        "red",
        "green",
        "adversarial",
        "prepare_pr",
        "hitl_merge_checkpoint",
        "land_deploy",
        "closeout"
      ]
    },
    "role": {
      "enum": [
        "orchestrator",
        "issue_planner",
        "test_writer",
        "code_writer",
        "adversarial_reviewer",
        "prepare_pr",
        "land_deploy",
        "closeout_retro",
        "human"
      ]
    }
  },
