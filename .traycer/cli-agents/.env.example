# Per-role CLI/model knobs for the Traycer CLI agents (bandit-loop).
#
# Copy this file to `.env` in the same dir and edit. `.env` is gitignored
# (machine-specific); THIS file is the committed source of truth so the config
# can be regenerated if the local `.env` is lost.
#
#   cp .env.example .env
#
# _lib.sh auto-sources `.env` beside it with `set -a`, so plain KEY=value lines
# are exported and win over the ambient environment.
#
# Two knobs per role (defaults let it run out of the box, so every line here is
# commented — an untouched copy behaves exactly like no `.env`; uncomment only
# what you change):
#
#   TRAYCER_<ROLE>_CLI     codex | claude | opencode          (default: codex)
#   TRAYCER_<ROLE>_MODEL   model id; empty => the CLI's default
#                            codex/claude: bare id      (gpt-5.5, claude-opus-4-8)
#                            opencode:     aperture/<model>   (must route via the
#                                          Aperture gateway; _lib.sh rejects others)
#
# The two read-only roles (ISSUE_PLANNER, ADVERSARIAL_REVIEWER) additionally need
# TRAYCER_<ROLE>_OPENCODE_AGENT — a preconfigured read-only opencode agent — but
# ONLY if you run that role on opencode (codex/claude enforce RO natively).

# issue-planner        LEVEL=RO       plan-work-item
#TRAYCER_ISSUE_PLANNER_CLI=codex
#TRAYCER_ISSUE_PLANNER_MODEL=
#TRAYCER_ISSUE_PLANNER_OPENCODE_AGENT=      # required only if _CLI=opencode

# test-writer          LEVEL=WRITE    write-red-tests
#TRAYCER_TEST_WRITER_CLI=codex
#TRAYCER_TEST_WRITER_MODEL=

# code-writer          LEVEL=WRITE    implement-green
#TRAYCER_CODE_WRITER_CLI=codex
#TRAYCER_CODE_WRITER_MODEL=

# adversarial-reviewer LEVEL=RO       adversarial-gate
#TRAYCER_ADVERSARIAL_REVIEWER_CLI=codex
#TRAYCER_ADVERSARIAL_REVIEWER_MODEL=
#TRAYCER_ADVERSARIAL_REVIEWER_OPENCODE_AGENT=   # required only if _CLI=opencode

# prepare-pr           LEVEL=WRITE_NET  prepare-pr
#TRAYCER_PREPARE_PR_CLI=codex
#TRAYCER_PREPARE_PR_MODEL=

# land-and-deploy      LEVEL=WRITE_NET  land-and-deploy
#TRAYCER_LAND_DEPLOY_CLI=codex
#TRAYCER_LAND_DEPLOY_MODEL=

# closeout-retro       LEVEL=WRITE    closeout-retro
#TRAYCER_CLOSEOUT_RETRO_CLI=codex
#TRAYCER_CLOSEOUT_RETRO_MODEL=
